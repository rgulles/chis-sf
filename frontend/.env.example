# Optional locally: omit API/storage bases to use the existing Vite proxy.
# Vercel: set both bases to https://chis-sf-production.up.railway.app and rebuild.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_STORAGE_BASE_URL=http://127.0.0.1:8000
VITE_GOOGLE_CLIENT_ID=

# Development/demo routing service. Use your own OSRM-compatible host for production.
VITE_OSRM_BASE_URL=https://router.project-osrm.org
